<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PERMISSIONS: reads need EventKit "Full Access to Calendars", which is a
  separate TCC grant from the Automation permission the writes use. A process
  holding only write-only access sees one calendar and reports no error, so the
  reader treats anything short of full access as a hard failure and skips the
  sync rather than emptying the Firestore mirror. If the log shows
  "EKAuthorizationStatus 4", that is this: grant Full Access under System
  Settings > Privacy & Security > Calendars for the process running this agent,
  then run `npm run sync` once from a terminal to confirm.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.notarangelo.calendar-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/npx</string>
        <string>tsx</string>
        <string>/Users/jacknotarangelo/Documents/GitHub/jax-assistant/bridge/calendar-sync.ts</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jacknotarangelo/Documents/GitHub/jax-assistant/bridge</string>

    <!--
      Polled, not watched. WatchPaths on ~/Library/Calendars does not fire:
      the Calendar store is TCC-protected and launchd cannot register a kqueue
      on it (verified empirically on macOS 26.5 — the same plist watching an
      unprotected directory fires in about a second, this one never fires at
      all). Granting Full Disk Access would be needed to change that, and it
      still would not be a documented contract, so this polls instead.

      A full run measured 30-50s wall clock against the 7-calendar allowlist,
      but only ~1.5s of that is CPU (3% of one core) — the rest is blocked
      waiting on Calendar.app. So the cost of polling often is latency, not
      load. Effective freshness is therefore ~2-3 min, not 2 min exactly.

      Runs overlapping the next tick is expected at this interval and is
      handled by the lock in calendar-sync.ts, which skips rather than racing.
      Do not drop below ~60s without re-measuring the read.
    -->
    <key>StartInterval</key>
    <integer>120</integer>

    <key>StandardOutPath</key>
    <string>/tmp/calendar-sync.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/calendar-sync.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>NODE_TLS_REJECT_UNAUTHORIZED</key>
        <string>0</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
